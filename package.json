{
    "name": "@ecomerece",
    "workspaces": [
        "apps/*",
        "packages/*"
    ],
    "scripts": {
        "dev": "bun run --filter api dev & bun run --filter web dev",
        "build": "bun run --filter api build",
        "typecheck": "bun run --filter '*' typecheck",
        "test": "bun test",
        "test:watch": "bun test --watch",
        "lint:imports": "bun run scripts/check-imports.ts",
        "lint": "biome lint src",
        "lint:fix": "biome check src --write",
        "format": "biome format src --write",
        "check": "biome check src"
    },
    "dependencies": {
        "@clerk/backend": "^3.8.0",
        "@hono/clerk-auth": "^3.1.1",
        "bson": "6",
        "dotenv": "^17.4.2",
        "glob": "^13.0.6",
        "hono": "^4.12.26",
        "jose": "^6.2.3",
        "mongoose": "8",
        "redis": "^6.0.0",
        "uuid": "^14.0.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.5.2",
        "@eslint/js": "^10.0.1",
        "@types/bun": "^1.4.0",
        "@types/node": "^25.9.1",
        "typescript": "5.9",
        "typescript-eslint": "^8.62.0"
    },
    "trustedDependencies": [
        "@clerk/shared"
    ]
}