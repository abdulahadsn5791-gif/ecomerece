{
    "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",

    "files": {
        "includes": ["**", "!node_modules", "!dist", "!build", "!.git", "!coverage"]
    },

    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100
    },

    "linter": {
        "enabled": true,
        "rules": {
            "preset": "recommended"
        }
    },

    "javascript": {
        "formatter": {
            "quoteStyle": "single",
            "semicolons": "always"
        }
    }
}
